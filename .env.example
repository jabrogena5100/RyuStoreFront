# Copy to .env (gitignored) and fill in. Never commit real values.

# Local Postgres (compose.yaml)
POSTGRES_DB=storefront
POSTGRES_USER=storefront
POSTGRES_PASSWORD=change-me-locally

# Used from phase 4 (Stripe test mode only; never live keys)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (printed by `stripe listen --forward-to localhost:8080/api/stripe/webhook`)

# Contact address for local Mailpit sender and, later, Terraform alarm subscriptions
ALERT_EMAIL=you@example.com
